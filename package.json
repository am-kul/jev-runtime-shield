{
  "name": "jev-runtime-shield",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time behavioral threat detection powered by Jev.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev apps/web --hostname 127.0.0.1",
    "demo": "cross-env DECISION_MODE=replay next dev apps/web --hostname 127.0.0.1",
    "build": "next build apps/web",
    "start": "next start apps/web --hostname 127.0.0.1",
    "reset": "tsx scripts/reset.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "record": "tsx scripts/record.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "dotenv": "17.2.3",
    "framer-motion": "13.4.0",
    "lucide-react": "0.468.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "cross-env": "10.1.0",
    "eslint": "9.39.0",
    "eslint-config-next": "16.3.5",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "type": "module",
  "overrides": {
    "vite": "7.3.6"
  }
}

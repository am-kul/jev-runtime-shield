# Default: no credentials, no outbound inference calls.
DECISION_MODE=replay
# For official live inference: change to jev and supply your TypeSafe key.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=5000
OBSERVE_THRESHOLD=0.25
CHALLENGE_THRESHOLD=0.50
BLOCK_THRESHOLD=0.75
# Optional absolute SQLite path; default is <repository>/data/runtime-shield.db
# DATABASE_PATH=
# Optional public repository URL shown in the end card.
NEXT_PUBLIC_GITHUB_URL=
